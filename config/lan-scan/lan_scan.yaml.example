# lan-scan - example configuration
#
# Use with: lan-scan -c config/lan-scan/<profile>.yaml
#
# All keys are optional; commandline flags and environment variables
# (LAN_SCAN_NETWORK, LAN_SCAN_TIMEOUT, LAN_SCAN_WORKERS, LAN_SCAN_RATE,
# LAN_SCAN_MAX_HOSTS, LAN_SCAN_PORTS, LAN_SCAN_NO_DNS, LAN_SCAN_ALLOW_LARGE,
# LAN_SCAN_ALLOW_ROUTABLE) override the values below.
# Priority: commandline > environment > this file > built-in default.
#
# network        - CIDR to scan when --network is not given (default: auto-detect,
#                  only when exactly one candidate network exists)
# timeout        - per-host probe timeout in seconds (default: 1.0; Linux ping
#                  rounds up to whole seconds)
# workers        - maximum concurrent probes, 1-256 (default: 64)
# rate           - maximum addresses started per second, 0 = unlimited (default: 50)
# max_hosts      - refuse networks with more probe addresses than this (default: 1024)
# allow_large    - true to scan networks larger than max_hosts (default: false)
# allow_routable - true to scan globally routable address space (default: false).
#                  Prefer --allow-routable on the commandline so the decision
#                  is made per run.
# ports          - TCP ports to try if a host filters ICMP ping (default: none)
# no_dns         - true to skip reverse DNS lookups (default: false)
#
# Keep lan-scan profiles in config/lan-scan/, not config/: ssh-selector offers
# every *.yaml in ./ and ./config/ as a host file.

network: 192.168.1.0/24
timeout: 1.0
workers: 64
rate: 50
ports:
  - 22
  - 80
  - 443
no_dns: false
