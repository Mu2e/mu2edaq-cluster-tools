# lan-scan — example configuration
#
# All keys are optional; commandline flags and environment variables
# (LAN_SCAN_NETWORK, LAN_SCAN_TIMEOUT, LAN_SCAN_WORKERS, LAN_SCAN_PORTS)
# override the values below. Priority: commandline > environment > this file > built-in default.
#
# network — CIDR to scan when --network is not given (default: auto-detect)
# timeout — per-host probe timeout in seconds (default: 1.0)
# workers — number of concurrent probe threads (default: 64)
# ports   — TCP ports to try if a host filters ICMP ping (default: none)
# no_dns  — set true to skip reverse DNS lookups (default: false)

network: 192.168.1.0/24
timeout: 1.0
workers: 64
ports:
  - 22
  - 80
  - 443
no_dns: false
